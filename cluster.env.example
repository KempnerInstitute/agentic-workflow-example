# Copy this file to cluster.env and set your values. Git ignores cluster.env.
# Run "source cluster.env" before sbatch and before Claude Code. Each job script reads it too.

# Your SLURM account. sbatch reads SBATCH_ACCOUNT, so the job scripts have no account line.
export SBATCH_ACCOUNT=<your_account>

# Lab storage keeps the uv cache out of your home folder.
export UV_CACHE_DIR=/n/holylabs/LABS/<lab_name>/Users/<username>/.cache/uv

# Scratch storage holds the round checkpoints. FASRC deletes scratch files after 90 days.
export RUN_ROOT=$SCRATCH/<lab_name>/Lab/<username>/agentic-workflow-example/runs

# The shared, read-only copy of CIFAR-10 on the cluster.
export DATA_DIR=/n/holylfs06/LABS/kempner_shared/Everyone/testbed/vision/cifar10
